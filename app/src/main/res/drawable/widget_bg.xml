<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: translucent gradient + 1px light border (RemoteViews cannot blur). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="@color/widget_bg_end"
        android:startColor="@color/widget_bg_start"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_bg_stroke" />
</shape>
